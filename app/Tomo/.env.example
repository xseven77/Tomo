# Copy this file to .env.local and uncomment the options you use.

# Use a plist path relative to this directory, or an absolute path.
# TOMO_GEMINI_OAUTH_CONFIG_PLIST='Resources/GeminiOAuthConfig.plist'

# Alternatively, provide the Desktop OAuth client ID directly.
# TOMO_GEMINI_OAUTH_CLIENT_ID='YOUR_CLIENT_ID'

# Optional, for legacy OAuth clients only.
# TOMO_GEMINI_OAUTH_LEGACY_CLIENT_SECRET='YOUR_LEGACY_CLIENT_SECRET'
